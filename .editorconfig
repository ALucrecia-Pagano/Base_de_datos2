# Aplicar a texto nuevo; no convertir masivamente archivos existentes.
root = true

[*.{md,txt,js,sql,json,yml,yaml}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[{.gitignore,.editorconfig}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# No alterar evidencias originales ni aplicar formato a binarios.
[evidencias/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
